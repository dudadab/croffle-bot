{
	"name": "pipit-hub",
	"version": "1.0.0",
	"main": "dist/index.js",
	"author": "Croffle Dev.",
	"license": "MIT",
	"type": "commonjs",
	"description": "pipit-hub is a discord bot made by Croffle Dev.",
	"keywords": [
		"discord",
		"bot",
		"node",
		"typescript"
	],
	"homepage": "https://github.com/team-croffle/pipit-hub#readme",
	"bugs": {
		"url": "https://github.com/team-croffle/pipit-hub/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/team-croffle/pipit-hub.git"
	},
	"scripts": {
		"sapphire": "sapphire",
		"generate": "sapphire generate",
		"build": "tsc",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -w",
		"start": "node dist/index.js",
		"start:dev": "node --env-file=.env.development.local dist/index.js",
		"dev": "yarn build && yarn start:dev",
		"watch:start": "tsc-watch --onSuccess \"yarn start:dev\""
	},
	"dependencies": {
		"@discord-player/extractor": "^7.2.0",
		"@discordjs/opus": "^0.10.0",
		"@discordjs/voice": "^0.19.2",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/discord.js-utilities": "7.3.3",
		"@sapphire/framework": "^5.5.0",
		"@sapphire/pieces": "^4.4.1",
		"@sapphire/plugin-api": "^8.3.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"@sapphire/utilities": "^3.18.2",
		"@skyra/env-utilities": "^2.0.1",
		"colorette": "^2.0.20",
		"discord-player": "^7.2.0",
		"discord.js": "^14.27.0",
		"mediaplex": "^1.0.0",
		"play-dl": "^1.9.7",
		"prism-media": "^1.3.5",
		"youtubei.js": "^18.0.0"
	},
	"devDependencies": {
		"@sapphire/cli": "^1.9.3",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^26.2.0",
		"@types/ws": "^8.18.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"tsc-watch": "^7.2.1",
		"typescript": "~6.0.3"
	},
	"packageManager": "yarn@4.18.0",
	"lint-staged": {
		"*.{ts,tsx,js,jsx,vue}": [
			"oxfmt --write",
			"oxlint --fix"
		],
		"*.{css,md,json,yml,yaml}": [
			"oxfmt --write"
		]
	}
}
